{
  "description": "Maintient silencieusement le plugin et les protections locales des agents.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/session_start.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\session_start.py\"",
            "async": true,
            "timeout": 30,
            "statusMessage": "Vérification de l'agent"
          }
        ]
      }
    ]
  }
}
